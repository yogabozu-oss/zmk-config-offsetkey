#define BASE 0
#define LOWER 1
#define RAISE 2

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC  &kp F5    &kp N6
&kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T               &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSLH  &kp RBKT  &kp BSLH  &rgb_ug RGB_ON &kp T
&kp CAPS   &kp A     &kp S     &kp D     &kp F     &kp G               &kp H     &kp J     &kp K     &kp L     &kp ENTER &kp APOS  &kp ENTER &rgb_ug RGB_OFF &kp G
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B               &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT &kp UP    &kp DEL   &kp B
&kp LCTRL  &kp LGUI  &kp LALT  &mo 1               &mkp LCLK           &kp SPACE &kp RALT  &mo 2     &kp RCTRL &kp LEFT  &kp DOWN  &kp RIGHT &kp SPACE
&kp UP     &kp LEFT  &kp RIGHT &kp DOWN  &kp ENTER &kp SPACE           &mkp LCLK &mkp LCLK &mkp RCLK &none
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        layer_1 {
            bindings = <
&kp GRAVE  &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &trans    &kp HOME  &kp F6
&trans     &trans    &trans    &trans    &trans    &trans              &trans    &kp N4    &kp N5    &kp N6    &trans    &trans    &trans    &kp PG_UP &kp END   &trans
&trans     &trans    &trans    &trans    &trans    &trans              &trans    &kp N1    &kp N2    &kp N3    &trans    &trans    &kp PG_DN &kp INS   &trans
&trans     &trans    &trans    &trans    &trans    &trans              &none     &none     &trans    &trans    &trans    &trans    &trans    &trans    &trans
&trans     &trans    &trans    &trans              &trans              &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
&trans     &mmv MOVE_UP &mmv MOVE_LEFT &mmv MOVE_RIGHT &mmv MOVE_DOWN &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        layer_2 {
            bindings = <
&kp TILDE  &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &trans    &kp HOME  &kp F6
&trans     &trans    &trans    &trans    &trans    &trans              &out OUT_USB &out OUT_BLE &trans &trans &trans &trans &trans &trans &kp END &trans
&trans     &trans    &trans    &trans    &trans    &trans              &rgb_ug RGB_OFF &rgb_ug RGB_ON &rgb_ug RGB_EFF &rgb_ug RGB_EFR &rgb_ug RGB_SPI &trans &trans &kp INS &trans
&trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans     &trans    &trans    &trans              &trans              &trans    &trans    &trans    &trans    &trans    &bt BT_CLR_ALL &bt BT_CLR &trans
&trans     &trans    &trans    &trans    &trans    &trans              &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
